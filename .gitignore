# Secrets — never commit
.env

# Run outputs. Not reproducible from a commit — a rerun of a pinned commit
# produces a different rollout — so these are evidence, not cache.
#
# jobs/ is scratch: run_experiment.py archives the whole directory into the
# MLflow run, so a tracked run survives deleting it. Untracked runs do not.
# mlflow.db + mlartifacts/ are the durable store, and still unbacked-up
# (docs/versioning-gaps.md §1).
jobs/
mlruns/

# Scoped rather than a bare *.log: a blanket rule hid nine stray root-level
# logs from `git status` for a day, so they accumulated unseen.
jobs/**/*.log

# Local tooling
.venv/
__pycache__/
*.pyc
.DS_Store
mlflow.db
mlartifacts/

# Generated by the oracle gate on every run.
tools/oracle_report.json
